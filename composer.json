{
    "name": "tonsinn/img-navi-bundle",
    "type": "contao-bundle",
    "description": "Animierte Bildnavigation für Contao 5: 2-6 Bild-Panels, die bei Hover bzw. Tap mit Überschrift, Text und Button aufklappen",
    "keywords": [
        "contao",
        "contao-bundle",
        "bundle",
        "image",
        "navigation",
        "content element",
        "contao 5"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Mathias Ebert",
            "homepage": "https://tonsinn.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/core": "*"
    },
    "autoload": {
        "psr-4": {
            "Tonsinn\\ImgNaviBundle\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "contao-manager-plugin": "Tonsinn\\ImgNaviBundle\\ContaoManager\\Plugin",
        "logo": "https://raw.githubusercontent.com/tonsinn/img-navi-bundle/main/public/img-navi.svg"
    }
}
