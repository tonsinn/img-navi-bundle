{
    "name": "tonsinn/img-navi-bundle",
    "type": "contao-bundle",
    "description": "Animated image navigation for Contao 5 and 6 - 2 to 6 image panels that expand on hover or tap to reveal a headline, text and a call-to-action button.",
    "homepage": "https://img-navi.tonsinn.de",
    "keywords": [
        "contao",
        "contao-bundle",
        "contao5",
        "contao6",
        "content-element",
        "image",
        "navigation",
        "twig",
        "bildnavigation"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Mathias Ebert",
            "homepage": "https://tonsinn.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/core": "*"
    },
    "autoload": {
        "psr-4": {
            "Tonsinn\\ImgNaviBundle\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "extra": {
        "contao-manager-plugin": "Tonsinn\\ImgNaviBundle\\ContaoManager\\Plugin",
        "logo": "https://raw.githubusercontent.com/tonsinn/img-navi-bundle/main/public/img-navi.svg"
    }
}
