<xliff version="1.1">
  <file datatype="php" original="contao/languages/en/tl_content.php" source-language="en">
    <body>
      <trans-unit id="tl_content.imgnavi_legend">
        <source>Image navigation settings</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLayout.0">
        <source>Layout</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLayout.1">
        <source>Arrange the panels side by side (horizontal) or stacked (vertical). On screens narrower than 768px the panels are always stacked.</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLayoutOptions.horizontal">
        <source>horizontal (side by side)</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLayoutOptions.vertical">
        <source>vertical (stacked)</source>
      </trans-unit>
      <trans-unit id="tl_content.imgnavi_style_legend">
        <source>Frame and colours</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviBorderWidth.0">
        <source>Frame width</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviBorderWidth.1">
        <source>Width of the frame around each panel in pixels. Default: 2. Enter 0 for no frame.</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviBorderColor.0">
        <source>Frame colour</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviBorderColor.1">
        <source>Colour of the frame around each panel. Leave empty to use the default (white).</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviHeadlineColor.0">
        <source>Headline colour</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviHeadlineColor.1">
        <source>Colour of the panel headlines, including the label shown while the panel is collapsed. Leave empty to use the default (white).</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviButtonColor.0">
        <source>Button colour</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviButtonColor.1">
        <source>Background colour of the buttons. The hover colour is derived from it automatically. Leave empty to use the default (blue).</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLabel.0">
        <source>Headline while collapsed</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLabel.1">
        <source>Orientation of the panel headline while the panel is collapsed. Horizontal headlines wrap inside the visible strip. Only applies to the horizontal arrangement on screens from 768px; stacked panels always show horizontal headlines.</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLabelOptions.vertical">
        <source>vertical (rotated)</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviLabelOptions.horizontal">
        <source>horizontal (wrapping)</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviInitial.0">
        <source>Initially opened panel</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviInitial.1">
        <source>Number of the panel that is already open when the page loads. Hovering another panel opens that one instead. Leave empty to start with all panels closed.</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviSticky.0">
        <source>Keep panel open</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviSticky.1">
        <source>Leave the last opened panel open when the mouse leaves the image navigation, instead of closing it again.</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviHeight.0">
        <source>Height</source>
      </trans-unit>
      <trans-unit id="tl_content.imgNaviHeight.1">
        <source>Total height of the image navigation (px, vh or rem). Default: 600px.</source>
      </trans-unit>
    </body>
  </file>
</xliff>
