# =============================================================================
# testinstall.env – Zugangsdaten für die Test-Installationen des img-navi-bundle
# =============================================================================
# 1. Diese Vorlage als "testinstall.env" kopieren:   cp testinstall.env.example testinstall.env
# 2. Werte eintragen. Die echte Datei steht in .gitignore und wird NIE committet.
#
# Format: Shell-kompatibel (wird per "source" geladen). Werte immer in einfache
# Anführungszeichen setzen, damit Sonderzeichen (@ # $ < > Leerzeichen) sicher sind.

# -----------------------------------------------------------------------------
# 1) Remote-Testserver – SSH-Zugang
# -----------------------------------------------------------------------------
# Hostname oder IP des Servers
REMOTE_HOST='test.example.org'
# SSH-Port
REMOTE_PORT='22'
# SSH-Benutzer (bei KeyHelp: der Hosting-/Kunden-Benutzer, dem der vHost gehört)
REMOTE_USER='deploy'

# Authentifizierung – EINE der beiden Varianten ausfüllen:
# a) Passwort (wird über sshpass übergeben, erscheint nie in der Prozessliste)
REMOTE_PASSWORD=''
# b) Privater SSH-Schlüssel, z. B. '/home/tonsinn/.ssh/id_ed25519' – hat Vorrang, wenn gesetzt
REMOTE_KEY=''

# Contao-Projektverzeichnis auf dem Server (enthält composer.json, vendor/, public/)
# KeyHelp-Beispiel: '/home/users/<benutzer>/www/<domain>'
REMOTE_PATH='/var/www/contao'

# Öffentliche URL der Test-Installation (Frontend; Backend unter <URL>/contao)
REMOTE_URL='https://test.example.org'

# -----------------------------------------------------------------------------
# 2) Remote-Testserver – PHP 8.5 und Composer
# -----------------------------------------------------------------------------
# PHP-8.5-CLI auf dem KeyHelp-Server. Befehlsname aus dem PATH oder absoluter Pfad.
# Das Install-Skript prüft die Version und probiert als Fallback /opt/keyhelp-php85/bin/php.
REMOTE_PHP='keyhelp-php85'
# Composer: 'composer' (aus dem PATH) oder absoluter Pfad zu composer / composer.phar.
# Wird IMMER als "$REMOTE_PHP <composer>" gestartet, damit die Auflösung mit PHP 8.5 läuft.
REMOTE_COMPOSER='composer'

# -----------------------------------------------------------------------------
# 3) Remote-Testserver – Datenbank
# -----------------------------------------------------------------------------
# Nur für Kontrollabfragen (z. B. neue Spalten in tl_content prüfen).
# Die Schema-Migration selbst läuft über "contao-console contao:migrate".
DB_HOST='localhost'
DB_PORT='3306'
DB_NAME=''
DB_USER=''
DB_PASSWORD=''

# -----------------------------------------------------------------------------
# 4) Remote-Testserver – Contao-Backend-Login (Browser-Tests)
# -----------------------------------------------------------------------------
# Benutzer mit Administrator-Rechten (Artikel/Elemente anlegen, Bildgrößen verwalten)
CONTAO_ADMIN_USER='admin'
CONTAO_ADMIN_PASSWORD=''

# -----------------------------------------------------------------------------
# 5) Lokale DDEV-Instanz (~/contao57) – optional
# -----------------------------------------------------------------------------
LOCAL_URL='https://contao57.ddev.site'
LOCAL_ADMIN_USER='admin'
LOCAL_ADMIN_PASSWORD=''
